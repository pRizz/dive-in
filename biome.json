{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "ui/src/**",
      "ui/vite.config.ts",
      "ui/vite-env.d.ts",
      "scripts/**/*.mjs",
      "scripts/**/*.cjs",
      "!node_modules/**",
      "!ui/node_modules/**",
      "!ui/dist/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off",
        "useSelfClosingElements": "off",
        "useNumberNamespace": "off",
        "useExponentiationOperator": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noTemplateCurlyInString": "off",
        "noUselessEscapeInString": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noUselessEmptyExport": "off",
        "noUselessFragments": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "off",
        "useExhaustiveDependencies": "off"
      }
    }
  }
}
